<Project>

  <!--
    Repo-wide defaults. Keeps the main DataTableForge project (which sits at
    the repo root) from globbing files in sibling subprojects (e.g., the
    DataTableForge.Tests/ folder, including its obj/ and bin/), which would
    otherwise be picked up by the SDK's default <Compile Include="**\*.cs" />
    glob and collide as duplicate AssemblyInfo attributes or unresolved
    test-framework symbols.

    DataTableForge.Tests has its own .csproj — it sets its own
    DefaultItemExcludes back to the SDK default below, so its files only
    get compiled by *its* project, not by the main one.
  -->
  <PropertyGroup>
    <DefaultItemExcludes Condition="'$(MSBuildProjectName)' != 'DataTableForge.Tests'">$(DefaultItemExcludes);DataTableForge.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
