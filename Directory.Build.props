<Project>

  <!--
    Repo-wide defaults. Keeps the main DataTableForge project (which sits at
    the repo root) from globbing files generated by sibling projects' obj/
    and bin/ folders (e.g., DataTableForge.Tests/obj/Debug/net8.0/*.cs),
    which would otherwise collide as duplicate AssemblyInfo attributes.

    The SDK's default <Compile Remove="obj/**"/> only excludes the project's
    *own* obj/, not any nested ones. With a sibling test project under the
    main project's directory tree, we need to extend the exclusion globally.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\obj\**;**\bin\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
