<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the source files from the main project so we can test
         internal helpers without making them public. -->
    <Compile Include="..\Logger.cs" Link="src\Logger.cs" />
    <Compile Include="..\ModParser.cs" Link="src\ModParser.cs" />
    <Compile Include="..\ModValidator.cs" Link="src\ModValidator.cs" />
    <Compile Include="..\JsonDiagnostics.cs" Link="src\JsonDiagnostics.cs" />
    <!-- ModDirResolver is pure (no UAssetAPI dep) so it links cleanly into the
         test assembly; ForgeConfig is dragged in as a dependency. -->
    <Compile Include="..\ModDirResolver.cs" Link="src\ModDirResolver.cs" />
    <Compile Include="..\ForgeConfig.cs" Link="src\ForgeConfig.cs" />
    <!-- AssetInjector links in for the sex-mesh-fill helper tests; its ModData /
         SlotData / Logger deps are already linked above. -->
    <Compile Include="..\AssetInjector.cs" Link="src\AssetInjector.cs" />
    <!-- BuildPreparer: AutoMod_P path-mapping tests (UAssetAPI dep already referenced). -->
    <Compile Include="..\BuildPreparer.cs" Link="src\BuildPreparer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>..\libs\UAssetAPI.dll</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>

</Project>
